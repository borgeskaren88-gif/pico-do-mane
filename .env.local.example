# Copie este arquivo para .env.local (uso local) ou configure estas
# mesmas variáveis nas "Environment Variables" do projeto na Vercel.

# --- Banco de dados (Supabase) ---
# Encontradas em: Supabase → seu projeto → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# --- Os dois usuários (você e sua parceira/parceiro) ---
# Coloque o nome que deve aparecer no app e uma senha para cada um.
# Cada pessoa entra com a SUA senha; o nome mostra quem lançou cada gasto.
USUARIO1_NOME=Karen
USUARIO1_SENHA=troque-esta-senha-1
USUARIO2_NOME=Mariele
USUARIO2_SENHA=troque-esta-senha-2

# --- Segurança da sessão ---
# Uma frase secreta qualquer, só sua, usada para validar o login.
# Pode ser qualquer texto longo e aleatório - troque por algo próprio.
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio-so-seu
